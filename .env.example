# Copy to .env.local and fill in. Never commit the real key.

# ClickUp personal API key (ClickUp → avatar → Settings → Apps → API Token)
VITE_CLICKUP_API_KEY=pk_xxxxxxxx

# Optional. Omit to auto-use your first workspace.
# Workspace ID is the number in ClickUp URLs: app.clickup.com/{workspace_id}/...
VITE_CLICKUP_WORKSPACE_ID=

# Optional. Enables the GIF button — free key at https://developers.giphy.com
VITE_GIPHY_API_KEY=
